{
  "name": "solid-clean-code-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratorio independiente de Clean Code y SOLID en TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "demo:file": "npm run build && node dist/src/demo.js --file",
    "smells": "npm run build && node dist/examples/smells.js",
    "lint": "eslint src tests examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
